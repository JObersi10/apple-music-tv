# Copy to server/.env and fill in your paths.
# gamdl venv site-packages (provides gamdl + pywidevine):
GAMDL_SITE=/path/to/.local/pipx/venvs/gamdl/lib/pythonX.Y/site-packages
# Python interpreter inside that venv:
PYTHON_BIN=/path/to/.local/pipx/venvs/gamdl/bin/python3
# Binaries (leave as bare names to resolve from PATH):
MP4DECRYPT_BIN=mp4decrypt
FFMPEG_BIN=ffmpeg

# The decrypt script deliberately ignores the OS proxy settings (Windows WinINET /
# HTTP_PROXY). A VPN or accelerator that MITMs TLS with its own root CA otherwise
# makes every stream fail with CERTIFICATE_VERIFY_FAILED while browse/search still
# works. Set these only if you DO want the proxy used:
# AM_HTTP_PROXY=http://127.0.0.1:7890
# AM_CA_BUNDLE=/path/to/that/proxys-ca.pem

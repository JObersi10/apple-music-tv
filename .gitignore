# ─── Secrets / runtime state (NEVER commit) ───────────────────────────
server/auth-state.json
**/auth-state.json
*.mut
.env
.env.local
secrets.json

# ─── Node / Bun ───────────────────────────────────────────────────────
node_modules/
bun.lockb
npm-debug.log*
yarn-error.log

# ─── Android / Gradle ─────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
*.apk
*.aab
*.keystore
# …but DO track the shared debug keystore, so every build signs identically and
# updates in place. It's a debug-only key (public password), safe to commit.
!android/app/debug.keystore
*.jks
.cxx/

# ─── IDE / OS ─────────────────────────────────────────────────────────
.idea/
*.iml
.DS_Store
*.log

# ─── Caches / temp ────────────────────────────────────────────────────
am_stream_cache/
__pycache__/
*.pyc
/tmp/
scratchpad/

# Reverse-engineering reference sources (local only — large APK + 3rd-party src)
inspo : source codes/
